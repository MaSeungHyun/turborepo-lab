# git에 올리지 말고, EC2에서 `.env`로 복사해서 쓰세요.
# docker compose --env-file .env up -d

# Next가 Nest로 프록시할 주소. docker compose에서는 서비스 이름(server)을 씁니다.
# 로컬 next dev는 기본값 http://127.0.0.1:4000 을 사용합니다.
API_URL=http://server:4000

# Nest
PORT=4000
HOST=0.0.0.0

# 브라우저가 접속하는 주소. EC2에서는 http://<공인IP>:3000
WEB_ORIGIN=http://localhost:3000
